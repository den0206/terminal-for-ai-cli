{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run AI Terminal",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions"
      ],
      "preLaunchTask": "npm: compile",
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "sourceMaps": true,
      // "stopOnEntry": false,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    }
  ]
}
