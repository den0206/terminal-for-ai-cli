{
  "name": "terminal-for-ai-cli",
  "displayName": "Terminal For AI CLI",
  "description": "Terminal view in the Cursor secondary sidebar.",
  "version": "0.0.2",
  "publisher": "yuukisakai",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/den0206/terminal-for-ai-cli"
  },
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:terminal-for-ai-cli-view",
    "onCommand:terminal-for-ai-cli.focus"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "terminal-for-ai-cli",
          "title": "Terminal For AI",
          "icon": "media/icon-bit.png"
        }
      ]
    },
    "views": {
      "terminal-for-ai-cli": [
        {
          "type": "webview",
          "id": "terminal-for-ai-cli-view",
          "name": "Terminal"
        }
      ]
    },
    "commands": [
      {
        "command": "terminal-for-ai-cli.focus",
        "title": "Terminal For AI CLI: フォーカス"
      },
      {
        "command": "terminal-for-ai-cli.newSession",
        "title": "Terminal For AI CLI: 新しいセッション"
      },
      {
        "command": "terminal-for-ai-cli.cleanupImages",
        "title": "Terminal For AI CLI: 画像をクリーンアップ"
      }
    ],
    "configuration": {
      "title": "Terminal For AI CLI",
      "properties": {
        "aiTerminal.defaultShell": {
          "type": "string",
          "default": "",
          "description": "新しいセッションに使用するシェルのパス。空の場合はユーザーの既定シェルを使用します。"
        },
        "aiTerminal.startupCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "セッション作成時に順番に送信されるコマンドのリスト。"
        },
        "aiTerminal.themePreset": {
          "type": "string",
          "default": "modern",
          "enum": [
            "modern",
            "basic",
            "clearDark",
            "clearLight",
            "grass",
            "homebrew",
            "manPage",
            "ocean",
            "pro"
          ],
          "enumDescriptions": [
            "（おすすめ）VS Code のテーマに馴染む落ち着いた配色",
            "黒地に白文字のシンプルなクラシックターミナル",
            "暗めの背景に柔らかいシアン系文字色",
            "明るい背景にダークグレーの文字色",
            "緑基調のレトロな配色",
            "黒背景・ネオングリーンの Homebrew 風スタイル",
            "マニュアル風の淡い背景と濃い文字色",
            "青と白のコントラストが強い配色",
            "シルバーの筐体風ダークグレー配色"
          ],
          "description": "Webview 内のターミナルテーマ。Terminal For AI CLI ビュー内でも選択できます。"
        }
      }
    }
  },
  "scripts": {
    "bundle:webview": "esbuild src/webview/main.ts --bundle --format=iife --outfile=media/webview.js --platform=browser --sourcemap",
    "compile": "npm run bundle:webview && tsc -p ./",
    "rebuild:pty": "node scripts/rebuild-pty.mjs",
    "watch": "tsc -w -p ./",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "package": "node scripts/package-vsix.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/vscode": "^1.107.0",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vitest/ui": "^4.0.16",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "tslib": "^2.8.1"
  }
}
