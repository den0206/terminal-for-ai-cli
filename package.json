{
  "name": "terminal-for-ai-cli",
  "displayName": "Terminal For AI CLI",
  "description": "Terminal view in the Cursor secondary sidebar.",
  "version": "0.0.5",
  "publisher": "yuukisakai",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/den0206/terminal-for-ai-cli"
  },
  "engines": {
    "vscode": "^1.125.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "terminal-for-ai-cli",
          "title": "Terminal For AI",
          "icon": "media/icon-bit.png"
        }
      ]
    },
    "views": {
      "terminal-for-ai-cli": [
        {
          "type": "webview",
          "id": "terminal-for-ai-cli-view",
          "name": "Terminal"
        }
      ]
    },
    "commands": [
      {
        "command": "terminal-for-ai-cli.focus",
        "title": "Terminal For AI CLI: フォーカス"
      },
      {
        "command": "terminal-for-ai-cli.newSession",
        "title": "Terminal For AI CLI: 新しいセッション"
      },
      {
        "command": "terminal-for-ai-cli.cleanupImages",
        "title": "Terminal For AI CLI: 画像をクリーンアップ"
      }
    ],
    "configuration": {
      "title": "Terminal For AI CLI",
      "properties": {
        "aiTerminal.defaultShell": {
          "type": "string",
          "default": "",
          "description": "新しいセッションに使用するシェルのパス。空の場合はユーザーの既定シェルを使用します。"
        },
        "aiTerminal.startupCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "セッション作成時に順番に送信されるコマンドのリスト。"
        },
        "aiTerminal.themePreset": {
          "type": "string",
          "default": "modern",
          "enum": [
            "modern",
            "basic",
            "clearDark",
            "clearLight",
            "grass",
            "homebrew",
            "manPage",
            "ocean",
            "pro"
          ],
          "enumDescriptions": [
            "（おすすめ）VS Code のテーマに馴染む落ち着いた配色",
            "黒地に白文字のシンプルなクラシックターミナル",
            "暗めの背景に柔らかいシアン系文字色",
            "明るい背景にダークグレーの文字色",
            "緑基調のレトロな配色",
            "黒背景・ネオングリーンの Homebrew 風スタイル",
            "マニュアル風の淡い背景と濃い文字色",
            "青と白のコントラストが強い配色",
            "シルバーの筐体風ダークグレー配色"
          ],
          "description": "Webview 内のターミナルテーマ。Terminal For AI CLI ビュー内でも選択できます。"
        }
      }
    }
  },
  "scripts": {
    "bundle:webview": "esbuild src/webview/main.ts --bundle --format=iife --outfile=media/webview.js --platform=browser --sourcemap",
    "compile": "npm run bundle:webview && tsc -p ./",
    "watch": "tsc -w -p ./",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "package": "node scripts/stage-host-prebuild.mjs && node -e \"require('node:fs').mkdirSync('vsix',{recursive:true})\" && npx --yes @vscode/vsce package --out vsix/terminal-for-ai-cli.vsix"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.125.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  }
}
