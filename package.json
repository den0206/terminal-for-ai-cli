{
  "name": "ai-terminal",
  "displayName": "AI Terminal",
  "description": "Terminal view in the Cursor secondary sidebar.",
  "version": "0.0.1",
  "publisher": "yuukisakai",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:ai-terminal-view",
    "onCommand:ai-terminal.focus"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-terminal",
          "title": "AI Terminal",
          "icon": "media/terminal.svg"
        }
      ]
    },
    "views": {
      "ai-terminal": [
        {
          "type": "webview",
          "id": "ai-terminal-view",
          "name": "Terminal"
        }
      ]
    },
    "commands": [
      {
        "command": "ai-terminal.focus",
        "title": "AI Terminal: フォーカス"
      },
      {
        "command": "ai-terminal.newSession",
        "title": "AI Terminal: 新しいセッション"
      }
    ],
    "configuration": {
      "title": "AI Terminal",
      "properties": {
        "aiTerminal.defaultShell": {
          "type": "string",
          "default": "",
          "description": "新しいセッションに使用するシェルのパス。空の場合はユーザーの既定シェルを使用します。"
        },
        "aiTerminal.startupCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "セッション作成時に順番に送信されるコマンドのリスト。"
        }
      }
    }
  },
  "scripts": {
    "bundle:webview": "esbuild src/webview/main.ts --bundle --format=iife --outfile=media/webview.js --platform=browser --sourcemap",
    "compile": "npm run bundle:webview && tsc -p ./",
    "watch": "tsc -w -p ./",
    "lint": "eslint src --ext .ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/vscode": "^1.105.0",
    "esbuild": "^0.26.0",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
