# Source files (compiled to dist/)
src/**

# Test files
**/*.test.ts
**/*.test.js
**/__mocks__/**

# Development configuration
.vscode/**
.github/**
.git/**
.gitignore

# Build tools and scripts
scripts/**
vitest.config.mts
tsconfig.json

# Source maps (not needed in production)
**/*.map

# Documentation (keep README.md and LICENSE.md)
CHANGELOG.md

# Package files (node_modules は含める - node-pty 等の runtime 依存のため)
# パッケージ前に npm prune --omit=dev で devDependencies を外すと VSIX が軽量になる
*.vsix
vsix/**

# node-pty のネイティブビルド成果物・ソース
# build/Release はビルドしたマシンの arch のバイナリしか無く、
# かつ loadNativeModule が prebuilds より先に探すため必ず除外する
node_modules/node-pty/build/**
node_modules/node-pty/deps/**
node_modules/node-pty/src/**
node_modules/node-pty/node-addon-api/**
node_modules/node-pty/scripts/**
node_modules/node-pty/binding.gyp

# IDE and OS files
.DS_Store
*.swp
*.swo

# Claude/Cursor specific
.claude/**
.cursorrules

# Additional documentation (only keep README.md and LICENSE.md)
IMPROVEMENTS.md
IMPROVEMENTS_JP.md
README_JP.md

# README 用のデモ GIF は VSIX に含めない
media/demo.gif

# README 用の操作説明画像は VSIX に含めない（ウォークスルーが使うのは .svg のみ）
media/walkthrough/*.png
